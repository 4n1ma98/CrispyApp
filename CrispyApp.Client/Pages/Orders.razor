@page "/orders"
@using CrispyApp.Application.DTOs
@using CrispyApp.Client.Services
@inject PosApiService ApiService

<PageTitle>Ventas - CrispyApp</PageTitle>

<div class="main-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-receipt me-2 text-primary"></i> Historial de Ventas</h2>
    <div class="d-flex align-items-center">
        <label class="me-2 fw-bold">Fecha:</label>
        <input type="date" class="form-control" @bind="selectedDate" @bind:after="LoadOrders" />
    </div>
</div>

@if (isLoading)
{
    <p><em>Cargando ventas...</em></p>
}
else if (!orders.Any())
{
    <div class="alert alert-info">No se encontraron ventas para la fecha seleccionada.</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body position-relative">
                    <h5 class="card-title text-muted fw-bold">Total Recaudado</h5>
                    @if (isRevenueUnlocked)
                    {
                        <p class="card-text fs-2 fw-bold" style="color: var(--primary);">$@orders.Sum(o => o.TotalAmount).ToString("N0")</p>
                        <button class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-2 border-0" @onclick="ToggleLock" title="Bloquear"><i class="bi bi-unlock-fill"></i></button>
                    }
                    else
                    {
                        <p class="card-text fs-2 fw-bold text-muted">********</p>
                        <button class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-2 border-0" @onclick="ToggleLock" title="Desbloquear"><i class="bi bi-lock-fill"></i></button>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-muted fw-bold">Total Órdenes</h5>
                    <p class="card-text fs-2 fw-bold">@orders.Count</p>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped table-hover table-borderless shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th># Orden</th>
                <th>Hora</th>
                <th>Tipo</th>
                <th>Método de Pago</th>
                <th>Total (COP)</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td class="fw-bold">@order.OrderNumber</td>
                    <td>@order.Date.ToLocalTime().ToString("hh:mm tt")</td>
                    <td>@order.OrderTypeName</td>
                    <td>@order.PaymentMethodName</td>
                    <td class="fw-bold text-success">$@order.TotalAmount.ToString("N0")</td>
                    <td><span class="badge bg-secondary">@order.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showUnlockModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-shield-lock text-primary"></i> Seguridad</h5>
                    <button type="button" class="btn-close" @onclick="() => showUnlockModal = false"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-2">Ingresa tu contraseña para ver los ingresos:</p>
                    <input type="password" class="form-control mb-2" @bind="unlockPassword" placeholder="******" />
                    @if (!string.IsNullOrEmpty(unlockError))
                    {
                        <div class="text-danger small">@unlockError</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-action w-100 py-2" @onclick="VerifyAndUnlock">Desbloquear</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime selectedDate = DateTime.Today;
    private List<OrderDto> orders = new();
    private bool isLoading = true;

    private bool isRevenueUnlocked = false;
    private bool showUnlockModal = false;
    private string unlockPassword = string.Empty;
    private string? unlockError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            orders = await ApiService.GetOrdersByDateAsync(selectedDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleLock()
    {
        if (isRevenueUnlocked)
        {
            isRevenueUnlocked = false;
        }
        else
        {
            unlockPassword = string.Empty;
            unlockError = null;
            showUnlockModal = true;
        }
    }

    private async Task VerifyAndUnlock()
    {
        if (string.IsNullOrWhiteSpace(unlockPassword)) return;

        var success = await ApiService.VerifyPasswordAsync(unlockPassword);
        if (success)
        {
            isRevenueUnlocked = true;
            showUnlockModal = false;
        }
        else
        {
            unlockError = "Contraseña incorrecta";
        }
    }
}
</div>
