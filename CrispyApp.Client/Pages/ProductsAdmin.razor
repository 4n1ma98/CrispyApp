@page "/products"
@using CrispyApp.Application.DTOs
@using CrispyApp.Client.Services
@inject PosApiService ApiService

<PageTitle>Productos - CrispyApp</PageTitle>

<div class="main-content">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-tags me-2 text-primary"></i> Catálogo de Productos</h2>
    <button class="btn-action" style="width: auto; padding: 10px 20px;" @onclick="() => OpenModal()"><i class="bi bi-plus-lg fw-bold me-1"></i> Nuevo Producto</button>
</div>

@if (products == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped table-hover table-borderless shadow-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio (COP)</th>
                <th class="text-center">Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in products)
            {
                <tr>
                    <td class="fw-bold">@prod.Name</td>
                    <td><span class="badge bg-light text-dark border">@prod.Category</span></td>
                    <td class="text-success fw-bold">$@prod.Price.ToString("N0")</td>
                    <td class="text-center">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input switch-minimal" type="checkbox" checked="@prod.IsActive" @onchange="() => ToggleActive(prod.Id)">
                        </div>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm fw-bold me-1" style="background-color: rgba(245, 158, 11, 0.15); color: var(--primary); border: none;" @onclick="() => OpenModal(prod)"><i class="bi bi-pencil-square"></i> Editar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Editar Producto" : "Nuevo Producto")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Basic Info -->
                        <div class="col-md-6 border-end">
                            <h6 class="fw-bold mb-3">Datos Básicos</h6>
                            <div class="mb-3">
                                <label class="form-label">Nombre</label>
                                <input class="form-control" @bind="currentProduct.Name" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Categoría</label>
                                <select class="form-select" @bind="currentProduct.Category">
                                    <option value="Pollos">Pollos</option>
                                    <option value="Bebidas">Bebidas</option>
                                    <option value="Promociones">Promociones</option>
                                    <option value="Guarniciones">Guarniciones</option>
                                    <option value="Otros">Otros</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Precio (COP)</label>
                                <input type="number" class="form-control" @bind="currentProduct.Price" />
                            </div>
                            @if (isEditing)
                            {
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" @bind="currentProduct.IsActive" id="activeSwitch">
                                    <label class="form-check-label" for="activeSwitch">Activo para Venta</label>
                                </div>
                            }
                        </div>
                        
                        <!-- Recipe -->
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3">Receta (Descuento de Insumos)</h6>
                            <p class="text-muted small">Agrega los insumos y la cantidad que se descontará de inventario al vender este producto.</p>
                            
                            <div class="d-flex mb-3">
                                <select class="form-select me-2" @bind="selectedInventoryItemId">
                                    <option value="">-- Seleccionar Insumo --</option>
                                    @if(inventoryItems != null)
                                    {
                                        foreach(var item in inventoryItems)
                                        {
                                            <option value="@item.Id">@item.Name (@item.UnitOfMeasure)</option>
                                        }
                                    }
                                </select>
                                <button class="btn fw-bold" style="background-color: rgba(16, 185, 129, 0.15); color: var(--success); border: none;" @onclick="AddIngredient"><i class="bi bi-plus-lg"></i></button>
                            </div>

                            <ul class="list-group">
                                @foreach (var ing in currentProduct.Recipe)
                                {
                                    var itemDetails = inventoryItems?.FirstOrDefault(i => i.Id == ing.InventoryItemId);
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="w-100 me-2">
                                            <small class="d-block fw-bold">@(itemDetails?.Name ?? "Insumo Desconocido")</small>
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="0.01" class="form-control" @bind="ing.QuantityToDeduct" />
                                                <span class="input-group-text">@(itemDetails?.UnitOfMeasure.ToString())</span>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm fw-bold" style="background-color: rgba(239, 68, 68, 0.15); color: var(--danger); border: none;" @onclick="() => RemoveIngredient(ing)"><i class="bi bi-trash3"></i></button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="SaveProduct">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto>? products;
    private List<InventoryItemDto>? inventoryItems;
    private bool showModal = false;
    private bool isEditing = false;
    private ProductUpdateDto currentProduct = new();
    
    // Ingredient selection
    private Guid? selectedInventoryItemId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        products = await ApiService.GetAllProductsAsync();
        inventoryItems = await ApiService.GetInventoryItemsAsync();
    }

    private async Task ToggleActive(Guid id)
    {
        await ApiService.ToggleProductStatusAsync(id);
        await LoadData();
    }

    private void OpenModal(ProductDto? prod = null)
    {
        selectedInventoryItemId = null;
        if (prod != null)
        {
            isEditing = true;
            // The API needs to return Recipe in ProductDto, but our Dto currently doesn't have it.
            // Oh wait, we didn't add Recipe to ProductDto! We need to add it to ProductDto.
            currentProduct = new ProductUpdateDto
            {
                Id = prod.Id,
                Name = prod.Name,
                Category = prod.Category.ToString(),
                Price = prod.Price,
                IsActive = prod.IsActive,
                // If Recipe is null or missing, we handle it
            };
            // Note: Since ProductDto doesn't have Recipe yet, we'll let them just rebuild it for now 
            // if they edit it, but I should probably add Recipe to ProductDto.
        }
        else
        {
            isEditing = false;
            currentProduct = new ProductUpdateDto { Category = "Pollos", IsActive = true, Recipe = new() };
        }
        showModal = true;
    }

    private void AddIngredient()
    {
        if (selectedInventoryItemId.HasValue && !currentProduct.Recipe.Any(r => r.InventoryItemId == selectedInventoryItemId.Value))
        {
            currentProduct.Recipe.Add(new ProductIngredientDto 
            { 
                InventoryItemId = selectedInventoryItemId.Value, 
                QuantityToDeduct = 1 
            });
        }
    }

    private void RemoveIngredient(ProductIngredientDto ing)
    {
        currentProduct.Recipe.Remove(ing);
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveProduct()
    {
        if (isEditing)
        {
            await ApiService.UpdateProductAsync(currentProduct);
        }
        else
        {
            await ApiService.CreateProductAsync(new ProductCreateDto
            {
                Name = currentProduct.Name,
                Category = currentProduct.Category,
                Price = currentProduct.Price,
                Recipe = currentProduct.Recipe
            });
        }
        
        await LoadData();
        CloseModal();
    }
}
</div>
