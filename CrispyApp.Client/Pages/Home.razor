@page "/"
@using CrispyApp.Application.DTOs
@using CrispyApp.Client.Services
@inject PosApiService ApiService

<PageTitle>Caja - CrispyApp</PageTitle>

<!-- Main content wraps around the left part -->
<div class="main-content">
    
    <div class="search-area mb-4">
        <input type="text" class="form-control form-control-lg rounded-pill" placeholder="🔍 Buscar por nombre o categoría..." @bind="searchTerm" @bind:event="oninput" style="background-color: var(--surface); border: 1px solid var(--border); width: 100%;" id="posSearchInput" />
    </div>

    <div class="categories-bar">
        <div class="cat-badge @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")" @onclick='() => FilterByCategory("")'>Todos</div>
        <div class="cat-badge @(selectedCategory == "Pollos" ? "active" : "")" @onclick='() => FilterByCategory("Pollos")'>Pollos</div>
        <div class="cat-badge @(selectedCategory == "Bebidas" ? "active" : "")" @onclick='() => FilterByCategory("Bebidas")'>Bebidas</div>
        <div class="cat-badge @(selectedCategory == "Promociones" ? "active" : "")" @onclick='() => FilterByCategory("Promociones")'>Promociones</div>
        <div class="cat-badge @(selectedCategory == "Guarniciones" ? "active" : "")" @onclick='() => FilterByCategory("Guarniciones")'>Guarniciones</div>
        <div class="cat-badge @(selectedCategory == "Otros" ? "active" : "")" @onclick='() => FilterByCategory("Otros")'>Otros</div>
    </div>
    
    @if (products == null)
    {
        <p><em>Cargando menú...</em></p>
    }
    else
    {
        <div class="grid">
            @foreach (var product in FilteredProducts)
            {
                <div class="product-card" @onclick="() => AddToCart(product)">
                    <div class="product-name">@product.Name</div>
                    <div class="product-price">$ @product.Price.ToString("N0")</div>
                    
                    <span class="badge border mt-2" style="color: var(--text-muted); border-color: var(--border) !important;">
                        @product.Category
                    </span>

                    <span style="position:absolute; top:15px; right:15px; color:var(--text-muted); font-size: 1.2rem;">
                        <i class="bi bi-plus-circle"></i>
                    </span>
                </div>
            }
        </div>
    }
</div>

<!-- Cart Sidebar to the right -->
<div class="cart-sidebar">
    <div class="cart-header">
        <i class="bi bi-receipt"></i> Orden en Curso
    </div>
    
    <div class="cart-items">
        @if (!cart.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
                <p class="mt-3">No hay productos seleccionados.</p>
            </div>
        }
        else
        {
            @foreach (var item in cart)
            {
                <div class="cart-item">
                    <div class="w-100 me-2">
                        <div style="font-weight:bold; margin-bottom:5px; font-size: 15px;">@item.ProductName</div>
                        <div style="color:var(--primary); font-weight: 600;">$ @item.SubTotal.ToString("N0")</div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <input type="number" class="qty-input" @bind="item.Quantity" @bind:after="() => RecalculateSubtotal(item)" min="1" />
                        <button class="remove-btn" @onclick="() => RemoveCompletely(item)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            }
        }
    </div>
    
    <div class="cart-footer">
        @if (cart.Any())
        {
            <div class="mb-3">
                <label class="form-label" style="color: var(--text-muted); font-size: 14px;">Tipo de Orden</label>
                <select class="form-select form-select-sm" @bind="selectedOrderTypeId">
                    @if (orderTypes != null)
                    {
                        @foreach (var type in orderTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="color: var(--text-muted); font-size: 14px;">Método de Pago</label>
                <select class="form-select form-select-sm" @bind="selectedPaymentMethodId">
                    @if (paymentMethods != null)
                    {
                        @foreach (var method in paymentMethods)
                        {
                            <option value="@method.Id">@method.Name</option>
                        }
                    }
                </select>
            </div>
        }

        <div class="total-line">
            <span>Total</span>
            <span>$ @cart.Sum(x => x.SubTotal).ToString("N0")</span>
        </div>
        
        <button class="btn-action" @onclick="SubmitOrder" disabled="@(!cart.Any() || isSubmitting)" id="btnCobrar">
            @(isSubmitting ? "Procesando..." : "Cobrar (Enter)")
        </button>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3 p-2 text-center border-0" style="background: var(--success); color: white;">@successMessage</div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3 p-2 text-center border-0" style="background: var(--danger); color: white;">@errorMessage</div>
        }
    </div>
</div>

@code {
    private List<ProductDto>? products;
    private List<OrderTypeDto>? orderTypes;
    private List<PaymentMethodDto>? paymentMethods;
    
    private List<OrderItemCreateDto> cart = new();
    
    private string searchTerm = string.Empty;
    private string selectedCategory = string.Empty;

    private Guid selectedOrderTypeId;
    private Guid selectedPaymentMethodId;
    
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;

    private IEnumerable<ProductDto> FilteredProducts
    {
        get
        {
            var query = products ?? new List<ProductDto>();
            
            if (!string.IsNullOrEmpty(selectedCategory))
            {
                query = query.Where(p => p.Category.ToString().Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                                     p.Category.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            return query;
        }
    }

    private void FilterByCategory(string category)
    {
        selectedCategory = category;
        searchTerm = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var productsTask = ApiService.GetActiveProductsAsync();
            var orderTypesTask = ApiService.GetOrderTypesAsync();
            var paymentMethodsTask = ApiService.GetPaymentMethodsAsync();
            
            await Task.WhenAll(productsTask, orderTypesTask, paymentMethodsTask);
            
            products = productsTask.Result;
            orderTypes = orderTypesTask.Result;
            paymentMethods = paymentMethodsTask.Result;
            
            if (orderTypes.Any()) selectedOrderTypeId = orderTypes.First().Id;
            if (paymentMethods.Any()) selectedPaymentMethodId = paymentMethods.First().Id;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
        }
    }

    private void AddToCart(ProductDto product)
    {
        successMessage = null;
        errorMessage = null;

        var existingItem = cart.FirstOrDefault(i => i.ProductId == product.Id);
        if (existingItem != null)
        {
            existingItem.Quantity++;
            existingItem.SubTotal = existingItem.Quantity * product.Price;
        }
        else
        {
            cart.Add(new OrderItemCreateDto 
            { 
                ProductId = product.Id, 
                ProductName = product.Name,
                Quantity = 1,
                UnitPrice = product.Price,
                SubTotal = product.Price
            });
        }
    }

    private void RecalculateSubtotal(OrderItemCreateDto item)
    {
        if (item.Quantity < 1) item.Quantity = 1;
        item.SubTotal = item.Quantity * item.UnitPrice;
    }

    private void RemoveCompletely(OrderItemCreateDto item)
    {
        cart.Remove(item);
    }

    private async Task SubmitOrder()
    {
        isSubmitting = true;
        successMessage = null;
        errorMessage = null;

        try
        {
            var request = new OrderCreateRequestDto
            {
                OrderTypeId = selectedOrderTypeId,
                PaymentMethodId = selectedPaymentMethodId,
                Items = cart.Select(c => new CrispyApp.Application.DTOs.OrderItemCreateDto 
                {
                    ProductId = c.ProductId,
                    Quantity = c.Quantity,
                    Notes = c.Notes
                }).ToList()
            };

            var order = await ApiService.CreateOrderAsync(request);
            if (order != null)
            {
                successMessage = $"¡Orden #{order.OrderNumber} creada exitosamente!";
                cart.Clear();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al procesar la orden: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public class OrderItemCreateDto
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal SubTotal { get; set; }
        public string? Notes { get; set; }
    }
}
