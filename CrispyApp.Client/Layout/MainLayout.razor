@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="app-wrapper">
    <AuthorizeView>
        <Authorized>
            <div class="topbar">
                <a href="" class="logo">CRISPY<span style="color: var(--text-main);">APP</span></a>
                
                <div class="nav-links">
                    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-fill"></i> Caja
                    </NavLink>
                    <NavLink class="nav-item" href="orders">
                        <i class="bi bi-receipt"></i> Ventas
                    </NavLink>
                    <NavLink class="nav-item" href="products">
                        <i class="bi bi-tags"></i> Menú
                    </NavLink>
                    <NavLink class="nav-item" href="inventory">
                        <i class="bi bi-box"></i> Stock
                    </NavLink>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Cambiar Tema">
                        @if (isDarkMode)
                        {
                            <i class="bi bi-sun-fill text-warning"></i>
                        }
                        else
                        {
                            <i class="bi bi-moon-fill"></i>
                        }
                    </button>
                    
                    <!-- Perfil y Menú de Usuario -->
                    <div class="position-relative">
                        <div class="user-profile-btn d-flex align-items-center gap-2" @onclick="ToggleUserMenu" title="Opciones de perfil">
                            <div style="width:36px; height:36px; background:var(--primary); border-radius:50%; display:flex; align-items:center; justify-content:center; color:black; font-weight:bold; font-size: 16px;">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <span class="fw-bold d-none d-md-inline" style="color: var(--text-main);">
                                @context.User.Identity?.Name
                            </span>
                            <i class="bi bi-chevron-down small" style="color: var(--text-muted); font-size: 11px;"></i>
                        </div>

                        @if (showUserMenu)
                        {
                            <div class="user-dropdown-menu">
                                <div class="px-3 py-2 border-bottom" style="border-color: var(--border) !important;">
                                    <div class="fw-bold" style="color: var(--text-main);">@context.User.Identity?.Name</div>
                                    <div class="small text-muted">Administrador</div>
                                </div>
                                <div class="p-1">
                                    <button class="btn btn-sm w-100 text-start d-flex align-items-center gap-2 p-2 rounded-2 logout-btn" @onclick="Logout">
                                        <i class="bi bi-box-arrow-right fs-6"></i>
                                        <span>Cerrar Sesión</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="layout">
        @Body
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>

@code {
    private bool isDarkMode = true;
    private bool showUserMenu = false;

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task Logout()
    {
        showUserMenu = false;
        await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        ((CrispyApp.Client.Auth.JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        NavManager.NavigateTo("login", replace: true);
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("crispyApp.setTheme", isDarkMode);
    }
}